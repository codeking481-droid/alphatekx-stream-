{
  "name": "alphatekx-stream",
  "main": "src/index.ts",
  "compatibility_date": "2025-04-01",
  "assets": {
    "directory": "./public",
    "html_handling": "none",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/.well-known/*"
    ]
  },
  "vars": {
    "GOOGLE_REDIRECT_URI": "https://alphatekx.name.ng/api/auth/callback",
    "PAYSTACK_CURRENCY": "NGN",
    "PAYSTACK_PLAN_CURRENCY": "NGN",
    "PAYSTACK_LITE_AMOUNT": "500000",
    "PAYSTACK_MONTHLY_AMOUNT": "2850000",
    "PAYSTACK_YEARLY_AMOUNT": "15000000",
    "PRO_PRICE_KOBO": "2850000"
    ,"YOUTUBE_WEB_KEY": ""
    ,"YOUTUBE_DATA_API_KEY": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "alphatekx-db",
      "database_id": "a8e11a3b-b228-47dc-8c15-7cf35d13d80f"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "919050b7c88c493f9c26312b6cd7a4cd"
    },
    {
      "binding": "ALPHATEKX_KV",
      "id": "919050b7c88c493f9c26312b6cd7a4cd"
    }
  ],
  "triggers": {
    "crons": [
      "*/10 * * * *"
    ]
  }
}
